# ── Indispensables ──────────────────────────────────────────────────────
MISTRAL_API_KEY=          # Résumés, scores, /ask, /analyze. Sans elle : collecte seule.
TELEGRAM_BOT_TOKEN=       # Sans lui : bot désactivé.
TELEGRAM_CHAT_ID=         # Ton chat : notifications + seul chat autorisé à utiliser le bot.

# ── Autre fournisseur d'IA (compatible OpenAI), prioritaire sur Mistral ──
# Eden AI : LLM_BASE_URL=https://api.edenai.run/v3
# Scaleway : LLM_BASE_URL=https://api.scaleway.ai/v1
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# Prix du modèle, en dollars par million de tokens, pour estimer le coût affiché
# LLM_PRICE_INPUT=0.17
# LLM_PRICE_OUTPUT=0.66

# ── Recommandées ────────────────────────────────────────────────────────
DASHBOARD_TOKEN=          # Jeton de l'API REST et du tableau de bord (désactivés sans lui).
MCP_TOKEN=                # Protège /mcp (Bearer, ou URL /mcp/<jeton>). Sans lui : /mcp est public.
TAVILY_API_KEY=           # Complément web de /ask quand la veille est trop mince.

# ── Optionnelles (valeurs par défaut indiquées) ─────────────────────────
DB_PATH=./data/veille.db
# EXPORT_DIR=             # Dossier des exports (défaut : celui de la base)
# PORT=3000
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_MIN_INTERVAL_MS=1500   # Délai minimal entre deux appels Mistral
# COLLECT_INTERVAL_MINUTES=120
# ACTIVE_HOURS=9-19              # Plage de collecte, heure de Paris
# ITEMS_PER_SOURCE=5
# MAX_ENRICH_PER_RUN=60          # Plafond de résumés par collecte
# NOTIFY_MIN_SCORE=4
# WEEKLY_DIGEST=true             # Synthèse automatique le lundi
# TELEGRAM_PUBLIC=false          # true : n'importe qui peut utiliser le bot
